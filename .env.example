# Copy this file to .env and fill in your values. .env is never committed.

# Claude API key for the customer care virtual assistant (https://console.anthropic.com).
# Without it the chat still works, but every question goes straight to human customer care.
ANTHROPIC_API_KEY=

# Optional: model for the assistant (default claude-opus-5)
# CHAT_MODEL=claude-opus-5

# Demo mode: enables "Generate sample account history" when creating customers,
# and shows a one-line "sample data" note in the site footer. Leave off for a live site.
# DEMO_MODE=true

# Optional: first-run admin login (otherwise one is generated into data/admin-credentials.txt)
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=
